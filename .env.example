# Base local time, in 24-hour HH:MM format.
BASE_TIME=04:03

# Minutes added to BASE_TIME on each successive day.
DAILY_OFFSET_MINUTES=3

# Number of days before the scheduled time returns to BASE_TIME.
CYCLE_DAYS=10

# Directory containing BetterGI.exe.
BETTERGI_DIRECTORY=C:\Program Files\BetterGI

# Run mode: normal uses the schedule; quick runs 10 seconds after startup.
MODE=normal

# Action after the run finishes: hibernate or shutdown.
END_ACTION=hibernate
