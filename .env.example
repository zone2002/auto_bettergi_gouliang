# BetterGI scheduler group names, in execution order. Separate names with commas.
NORMAL_GROUPS=Group A,Group B
# Only required when MODE=test.
TEST_GROUPS=Test Group

# Base local time, in 24-hour HH:MM format.
BASE_TIME=04:03

# Minutes added to BASE_TIME on each successive day.
DAILY_OFFSET_MINUTES=3

# Number of days before the scheduled time returns to BASE_TIME.
CYCLE_DAYS=10

# Directory containing BetterGI.exe.
BETTERGI_DIRECTORY=C:\Program Files\BetterGI

# Maximum minutes to wait for YuanShen.exe to close after it starts.
YUANSHEN_CLOSE_TIMEOUT_MINUTES=120

# Run mode: normal uses the schedule; quick runs Normal groups 10 seconds after
# script startup; test runs Test groups 10 seconds after script startup.
MODE=normal

# Action after the run finishes: hibernate or shutdown.
END_ACTION=hibernate
